APP_ENV=development
DATABASE_URL=sqlite:///./opsnest_cloud.db
APP_PUBLIC_URL=http://localhost:8000
APP_SIGNING_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:8000

# Configure only on Render. Never commit real values to GitHub.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_PLAN_STARTER=
PAYPAL_PLAN_BUSINESS=
PAYPAL_PLAN_PRO=

# Required for production trial verification.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=OpsNest
TURNSTILE_SECRET_KEY=
